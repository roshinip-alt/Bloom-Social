{
  "name": "bloom-integration-node",
  "version": "1.0.0",
  "private": true,
  "description": "Bloom integration service: provider OAuth callbacks, token exchange and official-API sync adapters.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
